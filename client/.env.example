# Where the game server lives. Required for any deployed build.
#
# Local development against a server started with `npm run dev` in ../server:
#   VITE_SERVER_URL=ws://localhost:3000
#
# Deployed: use wss:// (not ws://) — a page served over https cannot open an
# insecure WebSocket, the browser blocks it.
#   VITE_SERVER_URL=wss://kpl-server.onrender.com

VITE_SERVER_URL=ws://localhost:3000
