generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Card {
  id        Int      @id @default(autoincrement())
  deckId    Int
  text      String
  tip       String?
  pick      Int      @default(0)
  deck      CardDeck @relation(fields: [deckId], references: [id])
}

model CardDeck {
  id        Int     @id @default(autoincrement())
  ownerUUID String
  name      String
  description String?
  public    Boolean @default(false)
  default   Boolean @default(false)
  cards     Card[]
}
